# ============================================================
# Database — Neon
# ============================================================
# From your Neon project dashboard: Connection Details.
#
# DATABASE_URL: the POOLED connection string (port 6543, includes
# `?pgbouncer=true`). This is what the app uses for every normal query —
# pooling is what prevents serverless functions from exhausting Neon's
# connection limit under real concurrent load (see BACKEND.md).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/autosoko?sslmode=require&pgbouncer=true"

# DIRECT_URL: the UNPOOLED connection string (port 5432, no pgbouncer
# param). Prisma Migrate needs a direct, session-level connection —
# migrations don't work through a transaction-mode pooler.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/autosoko?sslmode=require"

# ============================================================
# Auth.js
# ============================================================
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-real-generated-secret"

# Google OAuth — from console.cloud.google.com, OAuth 2.0 Client
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============================================================
# Rate limiting — Upstash Redis
# ============================================================
# From console.upstash.com, REST API section. Rate limiting fails OPEN
# (silently allows all requests) if these are unset — fine for local
# dev, NOT fine for production. See lib/auth/rateLimit.js.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
